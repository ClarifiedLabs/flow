# Copy this file to .env before running Docker Compose.

# Owner-scoped secret for human/admin CLI and web UI bootstrap.
# Generate with: openssl rand -hex 32
FLOW_OWNER_TOKEN=

# Non-root UID/GID used by the flow-server container.
FLOW_UID=1000
FLOW_GID=1000

# Git identity used for the squash-merge commit created by the server. Name
# and email must be set together or both left empty.
FLOW_GIT_COMMIT_NAME=
FLOW_GIT_COMMIT_EMAIL=
